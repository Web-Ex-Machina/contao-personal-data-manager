{
    "name": "webexmachina/contao-personal-data-manager",
    "description": "Personal Data Manager bundle for Contao Open Source CMS",
    "keywords": ["webexmachina", "bundle", "contao", "personal", "rgpd", "gpdr"],
    "type": "contao-bundle",
    "license": "LGPL-3.0-or-later",
    "homepage": "https://www.webexmachina.fr/",
    "authors": [
        {
            "name": "Web ex Machina",
            "homepage": "https://www.webexmachina.fr",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/Web-Ex-Machina/contao-personal-data-manager/issues",
        "source": "https://github.com/Web-Ex-Machina/contao-personal-data-manager"
    },
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-zip": "*",
        "contao/core-bundle": "^5.7",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/event-dispatcher": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/mailer": "^7.4",
        "symfony/mime": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/security-bundle": "^7.4",
        "symfony/translation-contracts": "^3.0",
        "webexmachina/contao-utils": "^2.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "contao/easy-coding-standard": "@stable",
        "rector/rector": "@stable",
        "phpstan/phpstan": "@stable",
        "contao/contao-rector": "dev-main"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "WEM\\PersonalDataManagerBundle\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "WEM\\PersonalDataManagerBundle\\ContaoManager\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": false,
            "contao/manager-plugin": false,
            "contao-community-alliance/composer-plugin": true,
            "php-http/discovery": false,
            "dealerdirect/phpcodesniffer-composer-installer": false
        }
    }
}
